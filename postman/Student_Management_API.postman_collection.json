{
  "info": {
    "_postman_id": "6c1848e3-23ef-4e67-b1f8-4a04dd7bb001",
    "name": "Student Management REST API",
    "description": "Requests for the Student Management REST API assignment. Start the local server on port 3000 before sending requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "studentId", "value": "1" }
  ],
  "item": [
    {
      "name": "GET - List all students",
      "request": { "method": "GET", "url": "{{baseUrl}}/students" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Returns 200', function () { pm.response.to.have.status(200); });", "pm.test('Response contains student array', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"] } }]
    },
    {
      "name": "GET - Get student by ID",
      "request": { "method": "GET", "url": "{{baseUrl}}/students/{{studentId}}" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Returns 200', function () { pm.response.to.have.status(200); });", "pm.test('Response contains the requested student', function () { pm.expect(pm.response.json().data.id).to.eql(Number(pm.collectionVariables.get('studentId'))); });"] } }]
    },
    {
      "name": "POST - Create student",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Jordan Lee\",\n  \"age\": 20,\n  \"course\": \"BCA\",\n  \"email\": \"jordan@example.com\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/students"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Returns 201 Created', function () { pm.response.to.have.status(201); });", "pm.test('Created student has an ID', function () { pm.expect(pm.response.json().data.id).to.be.a('number'); });", "pm.collectionVariables.set('studentId', pm.response.json().data.id);"] } }]
    },
    {
      "name": "PUT - Update student",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Jordan Lee Updated\",\n  \"age\": 21,\n  \"course\": \"BSc IT\",\n  \"email\": \"jordan@example.com\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/students/{{studentId}}"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Returns 200', function () { pm.response.to.have.status(200); });"] } }]
    },
    {
      "name": "DELETE - Delete student",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/students/{{studentId}}" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Returns 200', function () { pm.response.to.have.status(200); });"] } }]
    },
    {
      "name": "GET - Missing student (404)",
      "request": { "method": "GET", "url": "{{baseUrl}}/students/999999" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Returns 404 Not Found', function () { pm.response.to.have.status(404); });"] } }]
    },
    {
      "name": "POST - Invalid student (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"\",\n  \"age\": -2,\n  \"course\": \"\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/students"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Returns 400 Bad Request', function () { pm.response.to.have.status(400); });"] } }]
    }
  ]
}
